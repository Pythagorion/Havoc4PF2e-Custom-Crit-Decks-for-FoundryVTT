<div class="hcd-review-wrap">
{{#*inline "selectTokens"}}
<div class="hcd-review-select">
  {{#if noneFound}}<p class="hcd-review-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "HCD.Auto.Review.NoneFound"}}</p>{{/if}}
  <button type="button" data-action="useSelected" data-path="{{path}}">
    <i class="fa-solid fa-object-group"></i> {{localize "HCD.Auto.Review.UseSelected"}}{{#if limitHint}} ({{limitHint}}){{/if}}
  </button>
</div>
{{/inline}}
<div class="hcd-review-body">
  <h3 class="hcd-review-title">{{title}}</h3>

  {{#if editing}}
  <p class="hint">{{localize "HCD.Auto.Review.EditHint"}}</p>
  {{#each steps}}
  {{#if heading}}<p class="hcd-review-heading hcd-depth-{{depth}}">{{heading}}</p>{{/if}}
  <fieldset class="hcd-review-step hcd-depth-{{depth}}{{#unless enabled}} hcd-disabled{{/unless}}">
    <legend>
      <input type="checkbox" name="{{path}}.enabled" {{checked enabled}} data-tooltip="HCD.Auto.Review.Enabled">
      <i class="{{icon}}"></i> {{description}}
    </legend>
    {{#each fields}}
    <div class="form-group">
      <label>{{localize label}}</label>
      {{#if choices}}
      <select name="{{../path}}.{{key}}">
        {{selectOptions choices selected=value localize=true}}
      </select>
      {{else if isNumber}}
      <input type="number" name="{{../path}}.{{key}}" value="{{value}}" step="1">
      {{else if isBoolean}}
      <input type="checkbox" name="{{../path}}.{{key}}" {{checked value}}>
      {{else}}
      <input type="text" name="{{../path}}.{{key}}" value="{{value}}">
      {{/if}}
    </div>
    {{/each}}
    {{#if hasCandidates}}
    <div class="form-group stacked hcd-review-candidates">
      <label>{{localize "HCD.Auto.Review.Affected"}}</label>
      {{#each candidates}}
      <label class="checkbox"><input type="checkbox" name="{{../path}}.chosen.{{index}}" {{checked checked}}> {{name}}</label>
      {{/each}}
    </div>
    {{/if}}
    {{#if isArea}}{{> selectTokens}}{{/if}}
  </fieldset>
  {{/each}}

  {{else}}
  <p class="hint">{{localize "HCD.Auto.Review.Hint"}}</p>
  <ul class="hcd-review-list">
    {{#each steps}}
    {{#if heading}}<li class="hcd-review-heading hcd-depth-{{depth}}">{{heading}}</li>{{/if}}
    <li class="hcd-depth-{{depth}}{{#unless enabled}} hcd-disabled{{/unless}}{{#if isNote}} hcd-note{{/if}}">
      <i class="{{icon}}"></i> <span>{{description}}</span>
      {{#if isArea}}{{> selectTokens}}{{/if}}
    </li>
    {{/each}}
  </ul>
  {{/if}}
</div>

<footer class="hcd-review-footer">
  <button type="button" class="hcd-primary" data-action="apply" {{#unless hasSteps}}{{#unless editing}}disabled{{/unless}}{{/unless}}>
    <i class="fa-solid fa-check"></i> {{localize "HCD.Auto.Review.Apply"}}
  </button>
  {{#unless editing}}
  <button type="button" data-action="edit"><i class="fa-solid fa-pen"></i> {{localize "HCD.Auto.Review.Edit"}}</button>
  {{/unless}}
  <button type="button" data-action="skip"><i class="fa-solid fa-xmark"></i> {{localize "HCD.Auto.Review.Skip"}}</button>
</footer>
</div>
